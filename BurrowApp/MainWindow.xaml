<Window x:Class="Burrow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:b="clr-namespace:Burrow"
        Title="Burrow" Width="900" Height="880" Icon="app.ico"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI" Foreground="{StaticResource Text}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <Border Background="{StaticResource Bg}" CornerRadius="12" BorderBrush="#262A36" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown">
                <StackPanel Orientation="Horizontal" Margin="18,0" VerticalAlignment="Center">
                    <Image Source="app.ico" Width="18" Height="18" Margin="0,0,10,0"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="Burrow" FontWeight="SemiBold" FontSize="13"/>
                    <TextBlock Text="{b:T xaml.tagline}" Foreground="{StaticResource SubText}" FontSize="12" Margin="10,0,0,0"/>
                    <TextBlock x:Name="VersionText" Foreground="#5F6577" FontSize="12" Margin="10,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button x:Name="LangButton" Style="{StaticResource TitleBtn}" Width="Auto" Padding="10,0" FontFamily="Segoe UI Variable Text, Segoe UI"
                            FontSize="11.5" Click="Lang_Click" ToolTip="{b:T xaml.language}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE774;" FontFamily="{StaticResource Icons}" FontSize="12" Margin="0,1,6,0"/>
                            <TextBlock x:Name="LangText"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource TitleBtn}" Content="&#xE921;" Click="Min_Click" ToolTip="{b:T xaml.minimize}"/>
                    <Button Style="{StaticResource CloseBtn}" Content="&#xE8BB;" Click="Close_Click" ToolTip="{b:T xaml.hideToTray}"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="20,4,20,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <!-- ================= LEFT ================= -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Hero / power -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel VerticalAlignment="Center">
                            <Button x:Name="PowerButton" Width="168" Height="168" Cursor="Hand"
                                    HorizontalAlignment="Center" Click="Power_Click" ToolTip="{b:T xaml.power.tip}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid x:Name="g" RenderTransformOrigin="0.5,0.5" Background="Transparent">
                                            <ContentPresenter/>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="g" Property="RenderTransform">
                                                    <Setter.Value><ScaleTransform ScaleX="1.03" ScaleY="1.03"/></Setter.Value>
                                                </Setter>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="g" Property="RenderTransform">
                                                    <Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97"/></Setter.Value>
                                                </Setter>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Cursor" Value="Wait"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <Grid>
                                    <Ellipse x:Name="PowerGlow" Fill="#161921">
                                        <Ellipse.Effect>
                                            <DropShadowEffect BlurRadius="48" ShadowDepth="0" Color="#000000" Opacity="0.7"/>
                                        </Ellipse.Effect>
                                    </Ellipse>
                                    <Ellipse x:Name="PowerRing" Margin="6" StrokeThickness="3" Stroke="#3A3F4E"/>
                                    <Ellipse x:Name="SpinRing" Margin="6" StrokeThickness="3" Stroke="#F5B942"
                                             StrokeDashArray="16 140" StrokeDashCap="Round"
                                             Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <RotateTransform x:Name="SpinRot"/>
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                    <Ellipse Margin="20" Fill="#1B1F29"/>
                                    <TextBlock x:Name="PowerIcon" Text="&#xE7E8;" FontFamily="{StaticResource Icons}" FontSize="48"
                                               Foreground="#8B91A3" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>

                            <TextBlock x:Name="StatusTitle" FontSize="24" FontWeight="SemiBold" TextAlignment="Center"
                                       TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,26,0,6" MaxWidth="310"/>
                            <TextBlock x:Name="StatusSub" Style="{StaticResource Sub}" TextAlignment="Center"
                                       HorizontalAlignment="Center" MaxWidth="290"/>

                            <!-- Shown when Discord was already open before the bypass started -->
                            <Border x:Name="RestartDiscordPanel" Visibility="Collapsed" Margin="0,18,0,0" Padding="14,10"
                                    Background="#1B2033" BorderBrush="#3A4380" BorderThickness="1" CornerRadius="10" MaxWidth="300">
                                <StackPanel>
                                    <TextBlock Text="{b:T xaml.restartDiscord.hint}" Style="{StaticResource Sub}" TextAlignment="Center"
                                               Foreground="#C9CCD8"/>
                                    <Button x:Name="RestartDiscordButton" Style="{StaticResource Primary}" HorizontalAlignment="Center"
                                            Margin="0,10,0,0" Click="RestartDiscord_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE72C;" FontFamily="{StaticResource Icons}" Margin="0,1,7,0"/>
                                            <TextBlock Text="{b:T xaml.restartDiscord}"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Connection check -->
                    <Border Grid.Row="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <Button x:Name="TestButton" DockPanel.Dock="Right" Style="{StaticResource Ghost}" Click="Test_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72C;" FontFamily="{StaticResource Icons}" Margin="0,1,7,0"/>
                                        <TextBlock Text="{b:T xaml.test}"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="{b:T xaml.check.title}" Style="{StaticResource H}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <StackPanel x:Name="ProbePanel"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ================= RIGHT ================= -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <!-- Methods -->
                    <Border Style="{StaticResource Card}" Padding="18,14,18,12">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <Button x:Name="FindBestButton" DockPanel.Dock="Right" Style="{StaticResource Ghost}" Click="FindBest_Click"
                                        ToolTip="{b:T xaml.findbest.tip}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" Margin="0,1,7,0"/>
                                        <TextBlock Text="{b:T xaml.findbest}"/>
                                    </StackPanel>
                                </Button>
                                <StackPanel>
                                    <TextBlock Text="{b:T xaml.method.title}" Style="{StaticResource H}"/>
                                    <TextBlock Text="{b:T xaml.method.sub}" Style="{StaticResource Sub}" Margin="0,2,12,0"/>
                                </StackPanel>
                            </DockPanel>
                            <StackPanel x:Name="MethodsPanel"/>
                        </StackPanel>
                    </Border>

                    <!-- Options -->
                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="18,14">
                        <StackPanel>
                            <TextBlock Text="{b:T xaml.options}" Style="{StaticResource H}" Margin="0,0,0,4"/>

                            <DockPanel Margin="0,8">
                                <CheckBox x:Name="StartupSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="Startup_Click"/>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="{b:T opt.startup.title}" FontSize="13"/>
                                    <TextBlock Text="{b:T opt.startup.sub}" Style="{StaticResource Sub}"/>
                                </StackPanel>
                            </DockPanel>

                            <DockPanel Margin="0,8">
                                <CheckBox x:Name="DiscordOnlySwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="Option_Click"/>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="{b:T opt.discordOnly.title}" FontSize="13"/>
                                    <TextBlock Text="{b:T opt.discordOnly.sub}" Style="{StaticResource Sub}"/>
                                </StackPanel>
                            </DockPanel>

                            <DockPanel Margin="0,8">
                                <Button x:Name="DnsButton" DockPanel.Dock="Right" Style="{StaticResource Ghost}" Padding="10,5" Click="Dns_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="DnsText"/>
                                        <TextBlock Text="&#xE70D;" FontFamily="{StaticResource Icons}" FontSize="9" Margin="8,2,0,0"/>
                                    </StackPanel>
                                </Button>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="{b:T opt.dns.title}" FontSize="13"/>
                                    <TextBlock Text="{b:T opt.dns.sub}" Style="{StaticResource Sub}"/>
                                </StackPanel>
                            </DockPanel>

                            <DockPanel Margin="0,8,0,2">
                                <CheckBox x:Name="AutoUpdateSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="AutoUpdate_Click"/>
                                <Button x:Name="CheckUpdatesButton" DockPanel.Dock="Right" Style="{StaticResource Ghost}" Margin="0,0,12,0"
                                        Padding="10,5" Content="{b:T xaml.checkNow}" Click="CheckUpdates_Click"/>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="{b:T opt.updates.title}" FontSize="13"/>
                                    <TextBlock Text="{b:T opt.updates.sub}" Style="{StaticResource Sub}"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Activity -->
                    <Border Grid.Row="4" Style="{StaticResource Card}" Padding="18,12,10,12" MinHeight="104">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="{b:T xaml.activity}" Style="{StaticResource H}" Margin="0,0,0,6"/>
                            <TextBox x:Name="LogBox" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource SubText}" FontFamily="Cascadia Mono, Consolas" FontSize="11"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Hidden" CaretBrush="Transparent"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- ================= PICKERS (DNS, language) ================= -->
            <Popup x:Name="DnsPopup" PlacementTarget="{Binding ElementName=DnsButton}" Placement="Bottom" HorizontalOffset="-250"
                   VerticalOffset="6" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                <Border Width="340" Background="#161921" BorderBrush="#2E3446" BorderThickness="1" CornerRadius="12" Padding="8" Margin="0,0,14,14">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.5" Color="#000000"/>
                    </Border.Effect>
                    <StackPanel x:Name="DnsList"/>
                </Border>
            </Popup>
            <Popup x:Name="LangPopup" PlacementTarget="{Binding ElementName=LangButton}" Placement="Bottom" HorizontalOffset="-120"
                   VerticalOffset="2" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                <Border Width="230" Background="#161921" BorderBrush="#2E3446" BorderThickness="1" CornerRadius="12" Padding="8" Margin="0,0,14,14">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.5" Color="#000000"/>
                    </Border.Effect>
                    <StackPanel x:Name="LangList"/>
                </Border>
            </Popup>

            <!-- ================= UPDATE CARD (over the content, title bar stays usable) ================= -->
            <Grid x:Name="UpdateOverlay" Grid.Row="1" Visibility="Collapsed" Opacity="0">
                <Border Background="#C0080A10" CornerRadius="0,0,12,12" MouseLeftButtonDown="UpdateScrim_MouseDown"/>
                <Border x:Name="UpdateCard" Width="470" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{StaticResource CardBg}" BorderBrush="#2E3446" BorderThickness="1" CornerRadius="16"
                        Padding="28,26,28,22" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="UpdateCardScale" ScaleX="1" ScaleY="1"/>
                    </Border.RenderTransform>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="40" ShadowDepth="10" Direction="270" Opacity="0.6" Color="#000000"/>
                    </Border.Effect>
                    <StackPanel>
                        <Image x:Name="UpdIcon" Width="60" Height="60" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.Effect>
                                <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.55" Color="#5B5FEF"/>
                            </Image.Effect>
                        </Image>
                        <TextBlock x:Name="UpdTitle" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"
                                   TextAlignment="Center" TextWrapping="Wrap" Margin="0,14,0,0"/>
                        <TextBlock x:Name="UpdSub" Style="{StaticResource Sub}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,4,0,0"/>

                        <Border x:Name="UpdNotesCard" Background="#121620" BorderBrush="#232734" BorderThickness="1" CornerRadius="10"
                                Padding="16,12" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="{b:T upd.whatsNew}" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <StackPanel x:Name="UpdNotes"/>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="UpdStatus" FontSize="12" Foreground="#C9CCD8" Margin="2,16,0,6" TextWrapping="Wrap" Visibility="Collapsed"/>
                        <Grid x:Name="UpdTrack" Height="6" Visibility="Collapsed">
                            <Border CornerRadius="3" Background="#262B38"/>
                            <Border x:Name="UpdFill" CornerRadius="3" HorizontalAlignment="Left" Width="0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#14B8A6" Offset="0"/>
                                        <GradientStop Color="#5B5FEF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>

                        <StackPanel x:Name="UpdButtons" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                            <Button x:Name="UpdSkip" Style="{StaticResource Ghost}" Background="Transparent" Content="{b:T upd.skip}" Click="UpdSkip_Click"/>
                            <Button x:Name="UpdLater" Style="{StaticResource Ghost}" Content="{b:T upd.later}" Margin="8,0,0,0" Click="UpdLater_Click"/>
                            <Button x:Name="UpdInstall" Style="{StaticResource Primary}" Margin="8,0,0,0" Click="UpdInstall_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE896;" FontFamily="{StaticResource Icons}" Margin="0,1,7,0"/>
                                    <TextBlock Text="{b:T upd.install}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
