<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>DiscordUnblock</AssemblyName>
    <RootNamespace>DiscordUnblock</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.2.0</Version>
    <Product>DiscordUnblock</Product>
    <Description>Unblocks Discord using DPI circumvention (GoodbyeDPI), no VPN.</Description>
    <!-- Run on .NET 8 or any newer desktop runtime -->
    <RollForward>LatestMajor</RollForward>
    <!-- Keep the file version a plain "x.y.z" (no "+<git commit>" suffix) -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
    <Compile Include="..\Shared\*.cs" />
  </ItemGroup>

</Project>
